{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo 'static site, no build step'",
  "installCommand": "echo 'static site, no install step'",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/docs" },
    { "source": "/css/:path*", "destination": "/docs/css/:path*" },
    { "source": "/js/:path*", "destination": "/docs/js/:path*" },
    { "source": "/img/:path*", "destination": "/docs/img/:path*" }
  ],
  "headers": [
    {
      "source": "/docs/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}